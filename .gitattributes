# Chuẩn hoá line ending: repo luôn lưu LF, tránh diff rác khi dev trên Windows
* text=auto eol=lf

# Script shell chạy trong container Linux — bắt buộc LF
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Script Windows — giữ CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# File nhị phân — không đụng vào
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.pdf binary

# Lockfile: ẩn khỏi diff review, vẫn version bình thường
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
poetry.lock linguist-generated=true -diff
