# ==============================================================
# Frontend — copy thành .env.local khi chạy `npm run dev` ngoài docker.
#
# CẢNH BÁO: mọi biến NEXT_PUBLIC_* đều bị nhúng vào JS bundle gửi xuống
# trình duyệt. TUYỆT ĐỐI không đặt API key ở đây.
# ==============================================================

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Create Video VO3

# Bật/tắt tính năng chưa hoàn thiện
NEXT_PUBLIC_ENABLE_GALLERY=true
NEXT_PUBLIC_ENABLE_AUTH=false

# Giới hạn hiển thị phía client (server vẫn kiểm tra lại)
NEXT_PUBLIC_MAX_PROMPT_LENGTH=4000

# Tắt telemetry của Next.js
NEXT_TELEMETRY_DISABLED=1
