# ==============================================================
# Create Video VO3 — biến môi trường dùng chung cho docker compose
# Copy thành .env rồi điền giá trị thật:   cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore)
# ==============================================================

# ---------- Chung ----------
PROJECT_NAME=create-video-vo3
ENVIRONMENT=development              # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Ho_Chi_Minh

# ---------- Cổng expose ra máy host ----------
NGINX_PORT=80
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- PostgreSQL ----------
POSTGRES_USER=vo3
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vo3
# App chạy async (asyncpg):
DATABASE_URL=postgresql+asyncpg://vo3:change_me_in_production@postgres:5432/vo3
# Alembic chạy sync (psycopg v3) — phải trỏ cùng 1 database:
DATABASE_URL_SYNC=postgresql+psycopg://vo3:change_me_in_production@postgres:5432/vo3

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Bảo mật ----------
# Sinh khoá mới:  openssl rand -hex 32
SECRET_KEY=thay_bang_chuoi_ngau_nhien_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost

# ---------- Google Veo 3 ----------
# Lấy API key tại https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Kiểm tra tên model mới nhất tại https://ai.google.dev/gemini-api/docs/video
VEO_MODEL=veo-3.0-generate-preview
VEO_FAST_MODEL=veo-3.0-fast-generate-preview

# ---------- Seedance 1.5 (Volcengine Ark / BytePlus ModelArk) ----------
SEEDANCE_API_KEY=
# Trung Quốc:  https://ark.cn-beijing.volces.com/api/v3
# Quốc tế   :  https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-5-pro

# ---------- LLM sinh prompt (chat bot) ----------
# Model đọc yêu cầu người dùng và viết ra prompt video
PROMPT_LLM_PROVIDER=gemini           # gemini | anthropic | openai
PROMPT_LLM_MODEL=gemini-2.5-flash
PROMPT_LLM_TEMPERATURE=0.8
PROMPT_LLM_MAX_TOKENS=2048

# ---------- Provider video mặc định ----------
DEFAULT_VIDEO_PROVIDER=veo3          # veo3 | seedance
VIDEO_DEFAULT_DURATION=8             # giây
VIDEO_DEFAULT_ASPECT_RATIO=16:9      # 16:9 | 9:16 | 1:1
VIDEO_DEFAULT_RESOLUTION=1080p
VIDEO_JOB_TIMEOUT_SECONDS=900        # huỷ job nếu quá 15 phút
VIDEO_POLL_INTERVAL_SECONDS=10

# ---------- Giới hạn / chống lạm dụng ----------
RATE_LIMIT_PER_MINUTE=20
MAX_VIDEOS_PER_USER_PER_DAY=10
MAX_PROMPT_LENGTH=4000

# ---------- Lưu trữ video ----------
STORAGE_BACKEND=local                # local | s3 | gcs
STORAGE_LOCAL_PATH=/app/storage
PUBLIC_BASE_URL=http://localhost:8000
# Chỉ cần khi STORAGE_BACKEND=s3
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- Giao tiếp nội bộ giữa các service ----------
AI_SERVICE_URL=http://ai-service:8001
BACKEND_URL=http://backend:8000
INTERNAL_API_KEY=chuoi_bi_mat_giua_backend_va_ai_service

# ---------- Frontend (build-time, sẽ lộ ra browser) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Create Video VO3
