# Sao chép thành .env và không commit file .env.
INTERNAL_API_KEY=replace-with-a-long-random-secret
POYO_API_KEY=
POYO_BASE_URL=https://api.poyo.ai
POYO_MODEL=veo3.1-fast

VIDEO_PROVIDER=poyo
ENABLE_PAID_GENERATION=true
VIDEO_ENABLE_FAKE=false
VIDEO_ENABLE_POYO=true

VIDEO_OUTPUT_ALLOWED_HOST_SUFFIXES=.poyo.ai,.doculator.org
VIDEO_OUTPUT_MAX_BYTES=524288000

AI_SERVICE_URL=http://127.0.0.1:8001
VIDEO_EXECUTION_DATABASE_URL=sqlite:///./storage/mvp.sqlite3
STORAGE_LOCAL_PATH=./storage
LOCAL_VIDEO_WORKER=true
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
