# ==============================================================
# AI service — biến môi trường khi chạy ĐỘC LẬP (không qua docker compose).
#
#   python -m venv .venv && .venv\Scripts\activate
#   pip install -r requirements.txt
#   cp .env.example .env
#   uvicorn app.main:app --reload --port 8001
# ==============================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG
SERVICE_NAME=ai-service

# Chỉ backend được gọi service này — kiểm tra header X-Internal-Key
INTERNAL_API_KEY=dev_internal_key

# ---------- LLM sinh prompt ----------
PROMPT_LLM_PROVIDER=gemini           # gemini | anthropic | openai
PROMPT_LLM_MODEL=gemini-2.5-flash
PROMPT_LLM_TEMPERATURE=0.8
PROMPT_LLM_MAX_TOKENS=2048
PROMPT_SYSTEM_FILE=app/prompts/system_prompt.md
PROMPT_TEMPLATE_FILE=app/prompts/video_prompt_template.j2
STYLE_PRESETS_FILE=app/prompts/style_presets.yaml
NEGATIVE_PROMPTS_FILE=app/prompts/negative_prompts.yaml

# ---------- Google Veo 3 ----------
GOOGLE_API_KEY=
VEO_MODEL=veo-3.0-generate-preview
VEO_FAST_MODEL=veo-3.0-fast-generate-preview

# ---------- Seedance 1.5 ----------
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-5-pro

# ---------- Hành vi gen video ----------
DEFAULT_VIDEO_PROVIDER=veo3
VIDEO_DEFAULT_DURATION=8
VIDEO_DEFAULT_ASPECT_RATIO=16:9
VIDEO_DEFAULT_RESOLUTION=1080p
VIDEO_POLL_INTERVAL_SECONDS=10
VIDEO_JOB_TIMEOUT_SECONDS=900

# ---------- Retry khi provider lỗi ----------
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_SECONDS=5
PROVIDER_TIMEOUT_SECONDS=120

# ---------- Lưu video tải về ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
