# Merge selected settings into .env; do not replace existing keys/storage settings.
# Keep INTERNAL_API_KEY stable to decrypt keys entered through the UI.
VIDEO_PROVIDER=seedvis
VIDEO_ENABLE_SEEDVIS=true
ENABLE_PAID_GENERATION=true

SEEDVIS_BASE_URL=https://seedvis.com/api/v1
# Timed multi-scene native-audio story. Check live model availability first.
SEEDVIS_VIDEO_MODEL=Veo-3.1
# For standalone clips: seedance_2.5, seedance_2.0_fast, Omni-Flash.
IMAGE_PROVIDER=seedvis
SEEDVIS_IMAGE_MODEL=gpt-image-2
# Alternative image IDs: GEM_PIX_2, NARWHAL, HARBOR_SEAL.
# Enter Seedvis API key in workspace Settings; no plaintext key needed here.
# These values are defaults. Provider/model can also be selected per draft in the UI.

VIDEO_OUTPUT_ALLOWED_HOST_SUFFIXES=.bytepluses.com,.byteplus.com,.volces.com,.poyo.ai,.seedvis.com
