# Sao chép thành .env và không commit file .env.
# API key được đọc duy nhất bởi ai-service.
INTERNAL_API_KEY=replace-with-a-long-random-secret
SEEDANCE_API_KEY=replace-with-byteplus-modelark-api-key
SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=seedance-1-5-pro-251215

# Hai biến này cùng bật mới cho phép backend gửi tác vụ tính phí.
VIDEO_PROVIDER=seedance
ENABLE_PAID_GENERATION=true
VIDEO_ENABLE_FAKE=false

# Output chỉ được tải từ các hostname provider tin cậy.
VIDEO_OUTPUT_ALLOWED_HOST_SUFFIXES=.bytepluses.com,.byteplus.com,.volces.com
VIDEO_OUTPUT_MAX_BYTES=524288000

# Local MVP
AI_SERVICE_URL=http://127.0.0.1:8001
VIDEO_EXECUTION_DATABASE_URL=sqlite:///./storage/mvp.sqlite3
STORAGE_LOCAL_PATH=./storage
LOCAL_VIDEO_WORKER=true
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
