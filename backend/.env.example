# ==============================================================
# Backend — biến môi trường khi chạy ĐỘC LẬP (không qua docker compose).
# Khi chạy bằng compose thì .env ở thư mục gốc được nạp, file này không dùng tới.
#
# Chạy local:
#   python -m venv .venv && .venv\Scripts\activate
#   pip install -r requirements.txt -r requirements-dev.txt
#   cp .env.example .env
#   uvicorn app.main:app --reload
# ==============================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG
SERVICE_NAME=backend
API_V1_PREFIX=/api/v1

# Chạy ngoài docker -> host là localhost thay vì tên service
DATABASE_URL=postgresql+asyncpg://vo3:vo3@localhost:5432/vo3
DATABASE_URL_SYNC=postgresql+psycopg://vo3:vo3@localhost:5432/vo3
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=dev_secret_khong_dung_cho_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

AI_SERVICE_URL=http://localhost:8001
INTERNAL_API_KEY=dev_internal_key
AI_SERVICE_TIMEOUT_SECONDS=120

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
PUBLIC_BASE_URL=http://localhost:8000

VIDEO_JOB_TIMEOUT_SECONDS=900
VIDEO_POLL_INTERVAL_SECONDS=10
RATE_LIMIT_PER_MINUTE=20
MAX_VIDEOS_PER_USER_PER_DAY=10
